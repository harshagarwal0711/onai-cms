# Copy this file to `.env.local` and fill in the values from your Supabase project.
# Dashboard → Project Settings → API.

# The HTTPS URL of your Supabase project (e.g. https://abcd1234.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "anon" public key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SECRET — never commit, never ship to the browser.
# Used by the upload route (bypasses RLS to write to Storage) and the migration script.
SUPABASE_SERVICE_ROLE_KEY=

# OPTIONAL: the deployed storefront's base URL. Used to build "Preview on
# storefront" links inside the CMS. Leave blank during local dev.
# Example: https://onai.in
NEXT_PUBLIC_STOREFRONT_URL=
